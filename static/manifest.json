{
  "manifest_version": 3,
  "name": "Call Recorder for Google Meet",
  "version": "__VERSION__",
  "description": "Record Google Meet and other web call tabs, your mic and shared screen sound, on your own device. Nothing is uploaded.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Call Recorder for Google Meet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "konveneBridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [],
      "js": [
        "shareRelay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [],
      "js": [
        "sharePage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}

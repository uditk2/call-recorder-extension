{
  "name": "call-recorder-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that records Google Meet, Konvene and other WebRTC call tabs, your microphone and shared screen sound, on your own device. No server.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run test && npm run build && npm run validate",
    "build:dev": "node build.mjs --dev",
    "build:konvene": "node build.mjs --konvene",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "probe:audio": "node scripts/audio-probe.mjs",
    "quality": "python3 scripts/audio-quality.py"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vitest": "5.0.5"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "call-recorder",
    "meeting-recorder",
    "google-meet",
    "webrtc",
    "screen-recorder",
    "tab-capture",
    "noise-suppression",
    "rnnoise",
    "privacy",
    "offline",
    "konvene"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uditk2/call-recorder-extension.git"
  },
  "homepage": "https://github.com/uditk2/call-recorder-extension#readme",
  "bugs": {
    "url": "https://github.com/uditk2/call-recorder-extension/issues"
  }
}
